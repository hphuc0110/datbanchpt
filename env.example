# Copy to .env.local and fill in values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Pancake POS Open API ---
# Tạo API key: Pancake POS → Cấu hình → Nâng cao → Kết nối bên thứ 3 → Webhook/API → API KEY
# Base URL: https://pos.pages.fm/api/v1
PANCAKE_API_KEY=
PANCAKE_SHOP_ID=

# Kho hàng (lấy từ GET /shops/{SHOP_ID}/warehouses) — khuyến nghị
PANCAKE_WAREHOUSE_ID=

# Mặc định: đơn chỉ mang thông tin đặt bàn (dòng one-time 0đ "Đặt bàn"), không cần món catalog.
# Chỉ điền 2 biến dưới nếu muốn map sang 1 SP cố định trên Pancake:
# PANCAKE_BOOKING_PRODUCT_ID=
# PANCAKE_BOOKING_VARIATION_ID=

# Tắt sync tạm thời: PANCAKE_SYNC_ENABLED=false
